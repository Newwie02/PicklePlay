# Copy this file to `.env` and fill in the two values from your
# Supabase dashboard:  Project Settings -> API keys
#
#   EXPO_PUBLIC_SUPABASE_URL      e.g. https://bijhzbhbumnohsohezju.supabase.co
#   EXPO_PUBLIC_SUPABASE_ANON_KEY the anon / publishable key (safe to ship)
#
# Then restart Metro with a clean cache:  npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
